{
  "name": "mirror-relu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Webカメラ映像を端末内で解析し、顔まわりの無意識な動作に気づくためのTauriアプリ",
  "scripts": {
    "predev": "npm run setup:assets",
    "dev": "vite",
    "prebuild": "npm run setup:assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "setup:assets": "node scripts/setup-mediapipe-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "pretauri": "npm run setup:assets",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
