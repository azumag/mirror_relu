{
  "name": "mirror-relu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Webカメラ映像を端末内で解析し、顔まわりの無意識な動作に気づくためのTauriアプリ",
  "scripts": {
    "predev": "npm run setup:assets",
    "dev": "vite",
    "prebuild": "npm run setup:assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "node scripts/run-tests.mjs",
    "setup:assets": "node scripts/setup-mediapipe-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "pretauri": "npm run setup:assets",
    "tauri": "tauri",
    "e2e": "npm run e2e:renderer && npm run e2e:tauri",
    "e2e:renderer": "npm run check:e2e && wdio run e2e/wdio.browser.conf.ts",
    "e2e:tauri:build": "node scripts/build-e2e-tauri.mjs",
    "e2e:tauri": "npm run e2e:tauri:build && npm run check:e2e && wdio run e2e/wdio.tauri.conf.ts",
    "e2e:production-guard": "node scripts/check-production-bundle.mjs",
    "e2e:ci": "npm test && npm run check && npm run check:e2e && npm run build && npm run e2e:production-guard && npm run e2e:renderer"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1"
  },
  "devDependencies": {
    "@swc/core": "1.12.14",
    "@tauri-apps/cli": "2.11.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@wdio/browser-runner": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.31.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vite-plugin-top-level-await": "1.5.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
